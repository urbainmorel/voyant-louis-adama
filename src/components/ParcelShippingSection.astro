---
import { getParcelShippingData, getSiteSettings } from '../lib/sanity';

const parcelItems = await getParcelShippingData();
const SITE_CONFIG = await getSiteSettings();
---

<section id="expeditions" class="py-16 md:py-24 bg-white border-t border-[#F0F3FA] relative">
  <div class="max-w-6xl mx-auto px-5 sm:px-8">
    
    <!-- Section Header -->
    <div class="mb-10">
      <span class="text-[#FF8A00] font-semibold text-base sm:text-lg block mb-1">
        Preuves d'Expédition & Réception Garantie
      </span>
      <h2 class="text-2xl sm:text-4xl font-bold text-[#1F3E72] tracking-tight leading-snug sm:leading-[1.28]">
        Expéditions DHL & Envois Sécurisés dans le Monde<span class="text-[#FF8A00]">.</span>
      </h2>
    </div>

    <!-- Parcel Proofs Grid with Vertical Ratio Preserved -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 items-stretch">
      {parcelItems.map((item, index) => (
        <article 
          class={`rounded-2xl p-4 sm:p-5 bg-white border border-[#EEF2FF] shadow-[0_8px_25px_-8px_rgba(31,62,114,0.08)] hover:shadow-card-active hover:border-[#2949C6]/25 transition-all duration-300 flex flex-col group ${
            index === 0 ? 'sm:col-span-2 lg:col-span-1 border-[#2949C6]/20' : ''
          }`}
        >
          <!-- Vertical Frame with Exact Ratio and Zoom Lightbox -->
          <div 
            class="relative w-full aspect-[3/4] rounded-xl overflow-hidden bg-[#0D121F] mb-4 shadow-inner cursor-zoom-in group/img"
            data-zoom-src={item.image}
            data-zoom-title={item.title}
            role="button"
            tabindex="0"
            aria-label={`Agrandir ${item.title}`}
          >
            <picture>
              <source srcset={item.image} type="image/webp" />
              <img 
                src={item.image} 
                alt={`${item.title} - Expédition par le Médium Louis Adama`}
                title={item.title}
                width={item.width}
                height={item.height}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-contain group-hover/img:scale-105 transition-transform duration-500"
              />
            </picture>

            <!-- Hover Zoom Hint -->
            <div class="absolute inset-0 bg-black/30 opacity-0 group-hover/img:opacity-100 transition-opacity duration-300 flex items-center justify-center">
              <span class="w-10 h-10 rounded-full bg-white/90 backdrop-blur-md text-[#1F3E72] flex items-center justify-center shadow-lg">
                <i class="fa-solid fa-expand text-xs"></i>
              </span>
            </div>
          </div>

          <!-- Content Details -->
          <div>
            <p class="text-xs font-semibold text-[#FF8A00] flex items-center gap-1 mb-1">
              <i class="fa-solid fa-location-dot text-[11px]"></i>
              <span>{item.destination}</span>
            </p>
            
            <h3 class="text-base font-bold text-[#1F3E72] group-hover:text-[#2949C6] transition-colors leading-snug">
              {item.title}
            </h3>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
