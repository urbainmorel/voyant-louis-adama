---
import { getSiteSettings, getYoutubeVideos, getGalleryPhotos } from '../lib/sanity';

const SITE_CONFIG = await getSiteSettings();
const youtubeVideos = await getYoutubeVideos();
const photoCards = await getGalleryPhotos();
---

<section id="gallery" class="py-16 md:py-24 bg-white border-t border-[#F0F3FA]">
  <div class="max-w-6xl mx-auto px-5 sm:px-8">
    
    <!-- Part 1: YouTube Video Gallery (4 Real Videos) -->
    <div class="mb-20">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
        <div>
          <span class="text-[#FF8A00] font-semibold text-base sm:text-lg block mb-1">{SITE_CONFIG.videoGalleryBadge}</span>
          <h2 class="text-2xl sm:text-4xl font-bold text-[#1F3E72] tracking-tight leading-snug sm:leading-[1.28]">
            {SITE_CONFIG.videoGalleryTitle}<span class="text-[#FF8A00]">.</span>
          </h2>
        </div>
        <p class="text-[16px] sm:text-sm text-[#4A5568] max-w-sm">
          {SITE_CONFIG.videoGallerySubtitle}
        </p>
      </div>

      <!-- 4 YouTube Video Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
        {youtubeVideos.map((video, index) => (
          <div class={`rounded-2xl p-4 sm:p-5 bg-white transition-all duration-300 flex flex-col justify-between ${
            index === 0 
              ? 'shadow-card-active border-2 border-[#2949C6]/20' 
              : 'border border-[#F4F6FB] hover:border-[#EEF2FF] hover:shadow-card-active'
          }`}>
            <div>
              <!-- Responsive YouTube Video Container -->
              <div class="relative w-full aspect-video rounded-xl overflow-hidden bg-black shadow-md mb-4">
                <iframe 
                  class="w-full h-full border-0"
                  src={`https://www.youtube-nocookie.com/embed/${video.id}?rel=0&modestbranding=1`}
                  title={video.title}
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                  loading="lazy"
                ></iframe>
              </div>

              <!-- Content Meta -->
              <div class="px-1">
                <div class="flex items-center gap-2">
                  <span class="px-2.5 py-0.5 rounded-md bg-[#EEF2FF] text-[#2949C6] text-xs sm:text-[11px] font-bold">
                    {video.badge}
                  </span>
                  <span class="text-sm sm:text-xs text-[#4A5568] font-medium flex items-center gap-1">
                    <i class="fa-brands fa-youtube text-red-600 text-sm"></i>
                    <span>Vidéo Officielle</span>
                  </span>
                </div>
              </div>
            </div>

            <!-- Action Link towards WhatsApp -->
            <div class="mt-4 pt-3 border-t border-[#F0F3FA] flex items-center justify-between">
              <a 
                href={`https://wa.me/${SITE_CONFIG.phoneApi}?text=${encodeURIComponent(`Bonjour Maître Louis Adama, j'ai visionné votre vidéo YouTube "${video.title}" et je souhaite vous contacter.`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm sm:text-xs font-bold text-[#25D366] hover:underline inline-flex items-center gap-1.5"
              >
                <i class="fa-brands fa-whatsapp text-sm"></i>
                <span>Nous Contacter</span>
              </a>
              <span class="text-sm sm:text-[11px] text-[#4A5568] font-semibold">Sanctuaire Sacré</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Part 2: Visual Diary / 3D Centered Gallery Carousel (Matching User Design) -->
    <div class="pt-12 border-t border-[#F0F3FA] relative overflow-hidden">
      <!-- Section Header matching design: small uppercase tag + modern title -->
      <div class="text-center max-w-xl mx-auto mb-10">
        <span class="text-[#FF8A00] font-bold text-xs uppercase tracking-widest block mb-2">{SITE_CONFIG.photoGalleryBadge}</span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-[#1F3E72] tracking-tight leading-snug sm:leading-[1.28]">
          {SITE_CONFIG.photoGalleryTitle}<span class="text-[#FF8A00]">.</span>
        </h2>
      </div>

      <!-- Carousel Viewport Wrapper -->
      <div class="relative w-full max-w-5xl mx-auto py-6 sm:py-10">
        <!-- 
          Carousel Track:
          - Desktop: 5 visible items with center card prominent, sides layered
          - Mobile: exactly 3 images visible (center full 66-70%, left and right peek at 50% width)
        -->
        <div 
          id="visualGalleryTrack" 
          class="relative w-full h-[320px] sm:h-[420px] md:h-[480px] flex items-center justify-center select-none"
        >
          {photoCards.map((p, idx) => (
            <div
              class="gallery-slide absolute rounded-2xl sm:rounded-3xl overflow-hidden cursor-pointer shadow-lg transition-all duration-500 ease-out bg-[#131117] border border-white/20"
              data-index={idx}
              data-img={p.image}
              data-title={p.title}
              role="button"
              tabindex="0"
              aria-label={`Photo ${idx + 1}`}
            >
              <picture>
                <source srcset={p.image} type="image/webp" />
                <img 
                  src={p.image} 
                  alt={p.title}
                  title={p.title}
                  width="400"
                  height="500"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover pointer-events-none"
                />
              </picture>
              <!-- Sleek subtle hover expand indicator, zero text on card -->
              <div class="absolute inset-0 bg-black/20 opacity-0 hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                <span class="w-11 h-11 rounded-full bg-white/90 backdrop-blur-md text-[#1F3E72] flex items-center justify-center shadow-lg">
                  <i class="fa-solid fa-expand text-sm"></i>
                </span>
              </div>
            </div>
          ))}
        </div>

        <!-- Navigation Controls: Minimal round arrows below matching the design -->
        <div class="flex items-center justify-center gap-4 mt-6">
          <button 
            id="galleryPrevBtn" 
            type="button" 
            aria-label="Image précédente"
            class="w-10 h-10 rounded-full border border-[#D5DCEB] bg-white text-[#1F3E72] hover:bg-[#2949C6] hover:text-white hover:border-[#2949C6] flex items-center justify-center shadow-sm transition-all duration-200 cursor-pointer active:scale-95"
          >
            <i class="fa-solid fa-arrow-left text-xs"></i>
          </button>
          <button 
            id="galleryNextBtn" 
            type="button" 
            aria-label="Image suivante"
            class="w-10 h-10 rounded-full border border-[#D5DCEB] bg-white text-[#1F3E72] hover:bg-[#2949C6] hover:text-white hover:border-[#2949C6] flex items-center justify-center shadow-sm transition-all duration-200 cursor-pointer active:scale-95"
          >
            <i class="fa-solid fa-arrow-right text-xs"></i>
          </button>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- Sleek Minimal Lightbox Modal (Pure Visual, No redundant text) -->
<div id="mediaModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6 bg-black/90 backdrop-blur-md">
  <div class="relative max-w-4xl w-full max-h-[90vh] flex flex-col items-center justify-center">
    <!-- Close button -->
    <button id="closeMediaModalBtn" class="absolute -top-12 right-0 sm:top-2 sm:right-2 z-10 w-10 h-10 rounded-full bg-black/60 hover:bg-[#2949C6] text-white flex items-center justify-center transition cursor-pointer">
      <i class="fa-solid fa-xmark text-lg"></i>
    </button>
    <div class="w-full overflow-hidden rounded-2xl border border-white/10 shadow-2xl bg-black">
      <img id="mediaModalImg" src="" alt="Photo Sanctuaire" class="w-full max-h-[80vh] object-contain mx-auto" />
    </div>
  </div>
</div>

<script>
  function setupGalleryCarousel() {
    const track = document.getElementById('visualGalleryTrack');
    const slides = Array.from(document.querySelectorAll('.gallery-slide')) as HTMLElement[];
    const prevBtn = document.getElementById('galleryPrevBtn');
    const nextBtn = document.getElementById('galleryNextBtn');
    const modal = document.getElementById('mediaModal');
    const modalImg = document.getElementById('mediaModalImg') as HTMLImageElement;
    const closeBtn = document.getElementById('closeMediaModalBtn');

    if (!track || slides.length === 0) return;

    let currentIndex = 0;
    const total = slides.length;

    function updateSlidePositions() {
      const isMobile = window.innerWidth < 768;

      slides.forEach((slide, idx) => {
        // Calculate offset relative to currentIndex (-total/2 to +total/2)
        let diff = (idx - currentIndex) % total;
        if (diff > total / 2) diff -= total;
        if (diff < -total / 2) diff += total;

        slide.onclick = null;

        if (isMobile) {
          // MOBILE SPEC: exactly 3 images visible.
          // Center card full (58% width), Left & Right peek at exactly 50% of their width inside viewport
          if (diff === 0) {
            // Main center image
            slide.style.transform = 'translateX(0) scale(1)';
            slide.style.width = '58%';
            slide.style.height = '100%';
            slide.style.zIndex = '30';
            slide.style.opacity = '1';
            slide.style.pointerEvents = 'auto';
            slide.style.filter = 'none';
            slide.style.boxShadow = '0 20px 40px -10px rgba(0,0,0,0.35)';
            slide.onclick = () => openLightbox(slide.getAttribute('data-img') || '');
          } else if (diff === -1) {
            // Left card peek: 50% visible, 50% off edge
            slide.style.transform = 'translateX(-58%) scale(0.86)';
            slide.style.width = '58%';
            slide.style.height = '88%';
            slide.style.zIndex = '15';
            slide.style.opacity = '0.9';
            slide.style.pointerEvents = 'auto';
            slide.style.filter = 'brightness(0.85)';
            slide.style.boxShadow = '0 10px 25px -5px rgba(0,0,0,0.2)';
            slide.onclick = () => { prev(); };
          } else if (diff === 1) {
            // Right card peek: 50% visible, 50% off edge
            slide.style.transform = 'translateX(58%) scale(0.86)';
            slide.style.width = '58%';
            slide.style.height = '88%';
            slide.style.zIndex = '15';
            slide.style.opacity = '0.9';
            slide.style.pointerEvents = 'auto';
            slide.style.filter = 'brightness(0.85)';
            slide.style.boxShadow = '0 10px 25px -5px rgba(0,0,0,0.2)';
            slide.onclick = () => { next(); };
          } else {
            // Hidden on mobile
            slide.style.transform = 'translateX(0) scale(0.5)';
            slide.style.width = '58%';
            slide.style.height = '80%';
            slide.style.zIndex = '0';
            slide.style.opacity = '0';
            slide.style.pointerEvents = 'none';
          }
        } else {
          // DESKTOP SPEC: 5 cards layered (2 left, 1 center, 2 right) matching design
          if (diff === 0) {
            // Center active card (raised, full focus, prominent shadow)
            slide.style.transform = 'translateX(0) scale(1.08)';
            slide.style.width = '300px';
            slide.style.height = '100%';
            slide.style.zIndex = '30';
            slide.style.opacity = '1';
            slide.style.filter = 'none';
            slide.style.boxShadow = '0 28px 50px -15px rgba(0,0,0,0.45)';
            slide.style.pointerEvents = 'auto';
            slide.onclick = () => openLightbox(slide.getAttribute('data-img') || '');
          } else if (diff === -1) {
            // Immediate left card
            slide.style.transform = 'translateX(-195px) scale(0.88)';
            slide.style.width = '280px';
            slide.style.height = '90%';
            slide.style.zIndex = '20';
            slide.style.opacity = '0.92';
            slide.style.filter = 'brightness(0.88)';
            slide.style.boxShadow = '0 16px 32px -10px rgba(0,0,0,0.3)';
            slide.style.pointerEvents = 'auto';
            slide.onclick = () => { prev(); };
          } else if (diff === 1) {
            // Immediate right card
            slide.style.transform = 'translateX(195px) scale(0.88)';
            slide.style.width = '280px';
            slide.style.height = '90%';
            slide.style.zIndex = '20';
            slide.style.opacity = '0.92';
            slide.style.filter = 'brightness(0.88)';
            slide.style.boxShadow = '0 16px 32px -10px rgba(0,0,0,0.3)';
            slide.style.pointerEvents = 'auto';
            slide.onclick = () => { next(); };
          } else if (diff === -2) {
            // Far left card
            slide.style.transform = 'translateX(-340px) scale(0.74)';
            slide.style.width = '260px';
            slide.style.height = '80%';
            slide.style.zIndex = '10';
            slide.style.opacity = '0.7';
            slide.style.filter = 'brightness(0.75)';
            slide.style.boxShadow = 'none';
            slide.style.pointerEvents = 'auto';
            slide.onclick = () => { currentIndex = (currentIndex - 2 + total) % total; updateSlidePositions(); };
          } else if (diff === 2) {
            // Far right card
            slide.style.transform = 'translateX(340px) scale(0.74)';
            slide.style.width = '260px';
            slide.style.height = '80%';
            slide.style.zIndex = '10';
            slide.style.opacity = '0.7';
            slide.style.filter = 'brightness(0.75)';
            slide.style.boxShadow = 'none';
            slide.style.pointerEvents = 'auto';
            slide.onclick = () => { currentIndex = (currentIndex + 2) % total; updateSlidePositions(); };
          } else {
            // Hidden behind
            slide.style.transform = 'translateX(0) scale(0.5)';
            slide.style.width = '240px';
            slide.style.height = '70%';
            slide.style.zIndex = '0';
            slide.style.opacity = '0';
            slide.style.pointerEvents = 'none';
          }
        }
      });
    }

    function prev() {
      currentIndex = (currentIndex - 1 + total) % total;
      updateSlidePositions();
    }

    function next() {
      currentIndex = (currentIndex + 1) % total;
      updateSlidePositions();
    }

    if (prevBtn) prevBtn.onclick = prev;
    if (nextBtn) nextBtn.onclick = next;

    // Swipe support for mobile
    let touchStartX = 0;
    track.addEventListener('touchstart', (e) => {
      touchStartX = e.touches[0].clientX;
    }, { passive: true });

    track.addEventListener('touchend', (e) => {
      const touchEndX = e.changedTouches[0].clientX;
      const diffX = touchEndX - touchStartX;
      if (Math.abs(diffX) > 40) {
        if (diffX > 0) prev();
        else next();
      }
    }, { passive: true });

    // Keyboard support
    window.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') prev();
      if (e.key === 'ArrowRight') next();
    });

    window.addEventListener('resize', updateSlidePositions);
    updateSlidePositions();

    // Lightbox modal logic
    function openLightbox(img: string) {
      if (!modal || !modalImg) return;
      modalImg.src = img;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    const closeModal = () => {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    };

    if (closeBtn) closeBtn.onclick = closeModal;
    if (modal) {
      modal.onclick = (e) => {
        if (e.target === modal) closeModal();
      };
    }
  }

  setupGalleryCarousel();
  document.addEventListener('astro:page-load', setupGalleryCarousel);
</script>
