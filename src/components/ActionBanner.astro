---
import { getSiteSettings } from '../lib/sanity';
const SITE_CONFIG = await getSiteSettings();
---

<section class="py-12 md:py-16 bg-white">
  <div class="max-w-6xl mx-auto px-5 sm:px-8">
    <div class="relative overflow-hidden rounded-[24px] bg-gradient-to-b from-[#3E5FE2] to-[#2949C6] border-[6px] border-[#5472E8] py-12 sm:py-14 px-6 sm:px-12 text-center shadow-[0_24px_50px_-12px_rgba(41,73,198,0.4)]">
      
      <!-- Decorative subtle arcs matching template -->
      <svg class="absolute left-0 bottom-0 w-72 h-72 opacity-15 pointer-events-none" viewBox="0 0 200 200" fill="none" aria-hidden="true">
        <circle cx="20" cy="180" r="90" stroke="white" stroke-width="1"/>
        <circle cx="20" cy="180" r="130" stroke="white" stroke-width="1"/>
        <circle cx="20" cy="180" r="170" stroke="white" stroke-width="1"/>
      </svg>

      <div class="relative z-10 max-w-2xl mx-auto">
        <h2 class="text-2xl sm:text-4xl font-bold text-white tracking-tight">
          Débloquez Votre Avenir Dès Aujourd'hui<span class="text-[#FF8A00]">.</span>
        </h2>
        <p class="mt-4 text-white/85 text-xs sm:text-sm leading-relaxed max-w-lg mx-auto">
          Prenez contact en toute confidentialité pour recevoir une réponse rapide et un diagnostic clair sur votre situation financière ou sentimentale.
        </p>

        <!-- Single Prominent WhatsApp CTA Button (Simple, Focused & High Converting) -->
        <div class="mt-8 flex justify-center">
          <a 
            href={`https://wa.me/${SITE_CONFIG.phoneApi}?text=${encodeURIComponent('Bonjour Maître Louis Adama, je souhaite une consultation confidentielle pour débloquer ma situation.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="px-9 py-4 rounded-xl bg-white hover:bg-[#25D366] text-[#1F3E72] hover:text-white font-bold text-sm sm:text-base transition-all duration-300 shadow-xl inline-flex items-center gap-3 transform hover:-translate-y-0.5 active:translate-y-0"
          >
            <i class="fa-brands fa-whatsapp text-2xl text-[#25D366] group-hover:text-white transition-colors"></i>
            <span>Nous Contacter</span>
          </a>
        </div>

        <div class="mt-7 text-white/70 text-xs flex items-center justify-center gap-4">
          <span><i class="fa-solid fa-lock text-[#25D366] mr-1"></i>Secret absolu</span>
          <span>•</span>
          <span><i class="fa-solid fa-shield-halved text-[#25D366] mr-1"></i>Zéro choc en retour</span>
          <span>•</span>
          <span><i class="fa-solid fa-clock text-[#FF8A00] mr-1"></i>Réponse 7j/7</span>
        </div>

      </div>

    </div>
  </div>
</section>
