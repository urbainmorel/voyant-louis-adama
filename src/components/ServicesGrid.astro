---
import { getServices, getSiteSettings } from '../lib/sanity';
const SERVICES = await getServices();
const SITE_CONFIG = await getSiteSettings();
---

<section id="residences" class="py-16 md:py-24 bg-white relative">
  <div class="max-w-6xl mx-auto px-5 sm:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
      <div>
        <span class="text-[#FF8A00] font-semibold text-base sm:text-lg block mb-1">{SITE_CONFIG.servicesBadge}</span>
        <h2 class="text-2xl sm:text-4xl font-bold text-[#1F3E72] tracking-tight leading-snug sm:leading-[1.28]">
          {SITE_CONFIG.servicesTitle}<span class="text-[#FF8A00]">.</span>
        </h2>
      </div>
      <p class="text-xs sm:text-sm text-[#8C8B91] max-w-sm">
        {SITE_CONFIG.servicesSubtitle}
      </p>
    </div>

    <!-- 6 Services Cards Directly Displayed in a 3x2 Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {SERVICES.map((item) => (
        <article 
          class={`group rounded-2xl p-4 transition-all duration-300 flex flex-col justify-between bg-white ${
            item.featured 
              ? 'shadow-card-active border-2 border-[#2949C6]/30' 
              : 'hover:shadow-card-active border border-[#F4F6FB] hover:border-[#EEF2FF]'
          }`}
        >
          <div>
            <!-- Clean Architectural Photo without any intrusive overlay button -->
            <div class="rounded-xl overflow-hidden h-56 mb-4 bg-[#F1F5FF] relative">
              <picture>
                <source srcset={item.image} type="image/webp" />
                <img 
                  src={item.image} 
                  alt={`${item.title} par le Grand Médium Voyant Africain Louis Adama`}
                  title={item.title}
                  width="400"
                  height="224"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </picture>
              <span class="absolute top-3 left-3 px-2.5 py-1 rounded-md bg-[#131117]/85 backdrop-blur-sm text-white text-[11px] font-bold">
                {item.badge}
              </span>
            </div>

            <div class="px-1 pb-1">
              <div class="text-sm font-bold text-[#8C8B91] mb-1">
                <span class="text-[#FF8A00] font-extrabold">✦</span> 
                <span class="text-[#2949C6] font-semibold">{item.price}</span>
              </div>
              <h3 class="text-lg sm:text-xl font-bold text-[#1F3E72] group-hover:text-[#2949C6] transition-colors leading-snug">
                {item.title}
              </h3>
              <p class="mt-2 text-sm sm:text-base text-[#8C8B91] leading-relaxed line-clamp-3">
                {item.description}
              </p>
            </div>
          </div>

          <div class="px-1 mt-4">
            <!-- Features Row -->
            <div class="py-3 border-t border-[#F0F3FA] flex items-center justify-between text-xs sm:text-[11px] text-[#8C8B91] font-medium">
              <span><i class="fa-solid fa-circle-check text-[#2949C6] mr-1"></i>{item.beds}</span>
              <span><i class="fa-solid fa-star text-[#FF8A00] mr-1"></i>{item.area}</span>
            </div>

            <!-- Ultra-Short Action Button with direct WhatsApp trigger -->
            <div class="pt-2">
              <a 
                href={`https://wa.me/${SITE_CONFIG.phoneApi}?text=${encodeURIComponent(item.whatsappMessage)}`}
                target="_blank"
                rel="noopener noreferrer"
                class={`w-full py-2.5 px-4 rounded-xl font-bold text-sm sm:text-sm flex items-center justify-center gap-2 transition-all duration-300 ${
                  item.featured
                    ? 'bg-gradient-to-r from-[#25D366] to-[#1DA851] text-white shadow-whatsapp-btn hover:opacity-95'
                    : 'bg-[#EEF2FF] text-[#2949C6] hover:bg-[#25D366] hover:text-white'
                }`}
              >
                <i class="fa-brands fa-whatsapp text-base"></i>
                <span>Nous Contacter</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
