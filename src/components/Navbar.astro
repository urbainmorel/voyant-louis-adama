---
import { getSiteSettings } from '../lib/sanity';

export interface Props {
  isInternalPage?: boolean;
}

const { isInternalPage = false } = Astro.props;
const homePrefix = isInternalPage ? '/' : '';
const SITE_CONFIG = await getSiteSettings();
---

<header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-[#131117]/95 backdrop-blur-md border-b border-white/5">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo: Médium Louis Adama with Cowrie SVG Logo -->
    <a href={`${homePrefix}#hero`} class="relative inline-flex items-center gap-2.5 group focus:outline-none">
      <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-br from-white/10 to-white/5 border border-white/10 p-1.5 flex items-center justify-center shadow-inner group-hover:border-[#E5A93C]/40 group-hover:shadow-[0_0_15px_rgba(229,169,60,0.2)] transition-all">
        <img src="/logo.svg" alt="Logo Cauris Sacré" width="36" height="36" class="w-full h-full object-contain group-hover:scale-105 transition-transform" />
      </div>
      <div class="flex flex-col">
        <span class="text-white font-bold text-lg sm:text-xl tracking-tight leading-none group-hover:text-white transition-colors">
          Médium Louis Adama
        </span>
        <span class="text-[10px] text-[#A7A6AC] font-medium tracking-wider uppercase mt-1">Voyance & Prospérité</span>
      </div>
    </a>

    <!-- Desktop Navigation Menu -->
    <nav class="hidden md:flex items-center gap-6 lg:gap-8 text-sm font-medium text-[#A7A6AC]">
      <a href={`${homePrefix}#residences`} class="hover:text-white transition-colors">Services</a>
      <a href={`${homePrefix}#values`} class="hover:text-white transition-colors">Valeurs</a>
      <a href={`${homePrefix}#gallery`} class="hover:text-white transition-colors">Galeries</a>
      <a href="/blog" class="hover:text-white transition-colors">Blog</a>
      <a href={`${homePrefix}#testimonials`} class="hover:text-white transition-colors">Avis</a>
      <a href={`${homePrefix}#faq`} class="hover:text-white transition-colors">FAQ</a>
    </nav>

    <!-- Right Actions: Ultra-short button Contact with WhatsApp -->
    <div class="flex items-center gap-3">
      <a 
        href={`https://wa.me/${SITE_CONFIG.phoneApi}?text=${encodeURIComponent('Bonjour Maître Louis Adama, je souhaite une consultation confidentielle.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg bg-gradient-to-r from-[#3858D6] to-[#2949C6] hover:from-[#25D366] hover:to-[#1DA851] text-white text-sm font-semibold shadow-blue-btn transition transform hover:-translate-y-0.5 active:translate-y-0"
      >
        <i class="fa-brands fa-whatsapp text-base text-white"></i>
        <span>Nous Contacter</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button 
        id="mobileMenuBtn" 
        type="button"
        aria-label="Menu de navigation" 
        class="md:hidden w-10 h-10 rounded-lg bg-white/10 text-white flex items-center justify-center hover:bg-white/20 transition cursor-pointer"
      >
        <i id="mobileMenuIcon" class="fa-solid fa-bars text-lg"></i>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobileMenu" class="hidden md:hidden bg-[#18161E] border-b border-white/10 px-6 py-5 space-y-3">
    <a href={`${homePrefix}#residences`} class="mobile-nav-link block py-2 text-white/90 font-medium hover:text-homyz-orange">Nos Services</a>
    <a href={`${homePrefix}#values`} class="mobile-nav-link block py-2 text-white/90 font-medium hover:text-homyz-orange">Nos Valeurs</a>
    <a href={`${homePrefix}#gallery`} class="mobile-nav-link block py-2 text-white/90 font-medium hover:text-homyz-orange">Galeries Photo & Vidéo</a>
    <a href="/blog" class="mobile-nav-link block py-2 text-white/90 font-medium hover:text-homyz-orange">Blog Spirituel (20 Guides)</a>
    <a href={`${homePrefix}#testimonials`} class="mobile-nav-link block py-2 text-white/90 font-medium hover:text-homyz-orange">Avis Clients</a>
    <a href={`${homePrefix}#faq`} class="mobile-nav-link block py-2 text-white/90 font-medium hover:text-homyz-orange">FAQ</a>
    <div class="pt-2">
      <a 
        href={`https://wa.me/${SITE_CONFIG.phoneApi}?text=${encodeURIComponent('Bonjour Maître Louis Adama, je souhaite une consultation confidentielle.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full py-3 rounded-lg bg-gradient-to-r from-[#25D366] to-[#1DA851] text-white font-semibold flex items-center justify-center gap-2.5 shadow-whatsapp-btn"
      >
        <i class="fa-brands fa-whatsapp text-lg"></i>
        <span>Nous Contacter</span>
      </a>
    </div>
  </div>
</header>

<script>
  function setupNavbar() {
    const btn = document.getElementById('mobileMenuBtn');
    const menu = document.getElementById('mobileMenu');
    const icon = document.getElementById('mobileMenuIcon');
    const links = document.querySelectorAll('.mobile-nav-link');

    if (!btn || !menu || !icon) return;

    btn.onclick = () => {
      menu.classList.toggle('hidden');
      if (menu.classList.contains('hidden')) {
        icon.className = 'fa-solid fa-bars text-lg';
      } else {
        icon.className = 'fa-solid fa-xmark text-lg';
      }
    };

    links.forEach(l => {
      l.addEventListener('click', () => {
        menu.classList.add('hidden');
        icon.className = 'fa-solid fa-bars text-lg';
      });
    });
  }

  setupNavbar();
  document.addEventListener('astro:page-load', setupNavbar);
</script>
