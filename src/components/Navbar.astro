---
import { getSiteSettings } from '../lib/sanity';

export interface Props {
  isInternalPage?: boolean;
}

const { isInternalPage = false } = Astro.props;
const homePrefix = isInternalPage ? '/' : '';
const SITE_CONFIG = await getSiteSettings();
---

<header 
  id="navbar" 
  class:list={[
    "fixed top-0 left-0 right-0 z-50 transition-all duration-300",
    isInternalPage 
      ? "bg-[#060D26]/90 backdrop-blur-md border-b border-white/10 shadow-[0_4px_30px_rgba(2,6,22,0.4)]" 
      : "bg-transparent border-b border-transparent"
  ]}
  data-internal={isInternalPage ? "true" : "false"}
>
  <div class="max-w-6xl mx-auto px-5 sm:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo: Médium Louis Adama with Cowrie SVG Logo -->
    <a href={`${homePrefix}#hero`} class="relative inline-flex items-center gap-3 group focus:outline-none">
      <img src="/logo.svg" alt="Logo Cauris Sacré Médium Louis Adama" width="40" height="40" class="w-9 h-9 sm:w-10 sm:h-10 object-contain group-hover:scale-105 transition-transform" />
      <div class="flex flex-col">
        <span class="text-white font-bold text-lg sm:text-xl tracking-tight leading-none group-hover:text-white transition-colors">
          Médium Louis Adama
        </span>
        <span class="text-[10px] text-[#A2B4D8] font-semibold tracking-wider uppercase mt-1">Voyance & Prospérité</span>
      </div>
    </a>

    <!-- Desktop Navigation Menu -->
    <nav class="hidden md:flex items-center gap-6 lg:gap-8 text-sm font-medium text-white/80">
      <a href={`${homePrefix}#residences`} class="hover:text-white transition-colors">Services</a>
      <a href={`${homePrefix}#values`} class="hover:text-white transition-colors">Valeurs</a>
      <a href={`${homePrefix}#gallery`} class="hover:text-white transition-colors">Galeries</a>
      <a href="/blog" class="hover:text-white transition-colors">Blog</a>
      <a href={`${homePrefix}#testimonials`} class="hover:text-white transition-colors">Avis</a>
      <a href={`${homePrefix}#faq`} class="hover:text-white transition-colors">FAQ</a>
    </nav>

    <!-- Right Actions: Ultra-short button Contact with WhatsApp -->
    <div class="flex items-center gap-3">
      <a 
        href={`https://wa.me/${SITE_CONFIG.phoneApi}?text=${encodeURIComponent('Bonjour Maître Louis Adama, je souhaite une consultation confidentielle.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg bg-gradient-to-r from-[#3858D6] to-[#2949C6] hover:from-[#25D366] hover:to-[#1DA851] text-white text-sm font-semibold shadow-blue-btn transition transform hover:-translate-y-0.5 active:translate-y-0"
      >
        <i class="fa-brands fa-whatsapp text-base text-white"></i>
        <span>Nous Contacter</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button 
        id="mobileMenuBtn" 
        type="button"
        aria-label="Menu de navigation" 
        class="md:hidden w-10 h-10 rounded-lg bg-white/10 text-white flex items-center justify-center hover:bg-white/20 transition cursor-pointer"
      >
        <i id="mobileMenuIcon" class="fa-solid fa-bars text-lg"></i>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobileMenu" class="hidden md:hidden bg-[#070F2E]/98 backdrop-blur-xl border-b border-white/10 px-6 py-5 space-y-3 shadow-2xl">
    <a href={`${homePrefix}#residences`} class="mobile-nav-link block py-2.5 text-[17px] text-white/95 font-medium hover:text-homyz-orange">Nos Services</a>
    <a href={`${homePrefix}#values`} class="mobile-nav-link block py-2.5 text-[17px] text-white/95 font-medium hover:text-homyz-orange">Nos Valeurs</a>
    <a href={`${homePrefix}#gallery`} class="mobile-nav-link block py-2.5 text-[17px] text-white/95 font-medium hover:text-homyz-orange">Galeries Photo & Vidéo</a>
    <a href="/blog" class="mobile-nav-link block py-2.5 text-[17px] text-white/95 font-medium hover:text-homyz-orange">Blog Spirituel (20 Guides)</a>
    <a href={`${homePrefix}#testimonials`} class="mobile-nav-link block py-2.5 text-[17px] text-white/95 font-medium hover:text-homyz-orange">Avis Clients</a>
    <a href={`${homePrefix}#faq`} class="mobile-nav-link block py-2.5 text-[17px] text-white/95 font-medium hover:text-homyz-orange">FAQ</a>
    <div class="pt-2">
      <a 
        href={`https://wa.me/${SITE_CONFIG.phoneApi}?text=${encodeURIComponent('Bonjour Maître Louis Adama, je souhaite une consultation confidentielle.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full py-3.5 rounded-lg bg-gradient-to-r from-[#25D366] to-[#1DA851] text-white font-semibold text-base flex items-center justify-center gap-2.5 shadow-whatsapp-btn"
      >
        <i class="fa-brands fa-whatsapp text-lg"></i>
        <span>Nous Contacter</span>
      </a>
    </div>
  </div>
</header>

<script>
  function setupNavbar() {
    const btn = document.getElementById('mobileMenuBtn');
    const menu = document.getElementById('mobileMenu');
    const icon = document.getElementById('mobileMenuIcon');
    const links = document.querySelectorAll('.mobile-nav-link');
    const header = document.getElementById('navbar');
    const isInternal = header?.getAttribute('data-internal') === 'true';

    function handleScroll() {
      if (!header || isInternal) return;
      if (window.scrollY > 25) {
        header.classList.remove('bg-transparent', 'border-transparent');
        header.classList.add('bg-[#060D26]/90', 'backdrop-blur-md', 'border-b', 'border-white/10', 'shadow-[0_4px_30px_rgba(2,6,22,0.4)]');
      } else {
        header.classList.add('bg-transparent', 'border-transparent');
        header.classList.remove('bg-[#060D26]/90', 'backdrop-blur-md', 'border-b', 'border-white/10', 'shadow-[0_4px_30px_rgba(2,6,22,0.4)]');
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    if (!btn || !menu || !icon) return;

    btn.onclick = () => {
      menu.classList.toggle('hidden');
      if (menu.classList.contains('hidden')) {
        icon.className = 'fa-solid fa-bars text-lg';
      } else {
        icon.className = 'fa-solid fa-xmark text-lg';
      }
    };

    links.forEach(l => {
      l.addEventListener('click', () => {
        menu.classList.add('hidden');
        icon.className = 'fa-solid fa-bars text-lg';
      });
    });
  }

  setupNavbar();
  document.addEventListener('astro:page-load', setupNavbar);
</script>
